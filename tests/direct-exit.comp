#version 450
#extension GL_GOOGLE_include_directive : require
layout(local_size_x=1) in;
#include "../shaders/abi.glsl"
#include "../shaders/hb.glsl"
// Block Drop's B/Minus exit path, isolated for comparison with Celeste's menu action.
void main() {
    uint pressed=hbPressed();
    if(hbConnected() && (pressed&(HB_B|HB_MINUS))!=0u)hbExit();
    hbEndFrame();
}
